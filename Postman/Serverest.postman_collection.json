        {
          "name": "Cadastrar usuário",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const timestamp = Date.now();\r\n",
                  "pm.environment.set(\"nome\", `Usuario QA ${timestamp}`);\r\n",
                  "pm.environment.set(\"email\", `qa${timestamp}@example.com`);\r\n",
                  "pm.environment.set(\"password\", \"SenhaQA123!\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Usuário cadastrado com sucesso\", function () { pm.response.to.have.status(201); });\r\n",
                  "const responseJson = pm.response.json();\r\n",
                  "pm.test(\"ID do usuário retornado\", function () { pm.expect(responseJson._id).to.exist; });\r\n",
                  "if (pm.response.code === 201 && responseJson._id) pm.environment.set(\"newUserId\", responseJson._id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
