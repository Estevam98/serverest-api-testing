      "item": [
        {
          "name": "Realizar login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let responseJson = (pm.response.json())\r",
                  "\r",
                  "let tokenSplit = responseJson['authorization'].split(' ')\r",
                  "\r",
                  "pm.globals.set(\"acessToken\", tokenSplit[1]);"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n\"email\": \"armando@qa.com.br\",\r\n\"password\": \"Nimbus2000\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/login",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        }
