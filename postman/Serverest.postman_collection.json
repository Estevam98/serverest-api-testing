              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Consulta do carrinho retorna 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Carrinho possui produtos\", function () {\r\n    const responseJson = pm.response.json();\r\n    pm.expect(responseJson.produtos).to.be.an(\"array\").that.is.not.empty;\r\n});\r\n\r\n\r\npm.test(\"Total do carrinho está correto\", function () {\r\n    const responseJson = pm.response.json();\r\n\r\n    const precoTotalCalculado = responseJson.produtos.reduce(\r\n        (total, produto) => total + produto.quantidade * produto.precoUnitario,\r\n        0\r\n    );\r\n\r\n    const quantidadeTotalCalculada = responseJson.produtos.reduce(\r\n        (total, produto) => total + produto.quantidade,\r\n        0\r\n    );\r\n\r\n    pm.expect(responseJson.precoTotal).to.eql(precoTotalCalculado);\r\n    pm.expect(responseJson.quantidadeTotal).to.eql(quantidadeTotalCalculada);\r\n});\r\n\r\n\r\npm.test(\"ID do carrinho foi retornado\", function () {\r\n    const responseJson = pm.response.json();\r\n    pm.expect(responseJson._id).to.exist;\r\n});\r\n"
