      "name": "Login",
      "item": [
        {
          "name": "Realizar login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();\r\n\r\npm.test(\"Login realizado com sucesso\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Token de autenticação retornado\", function () {\r\n    pm.expect(jsonData.authorization).to.exist;\r\n});\r\n\r\npm.environment.set(\"accessToken\", jsonData.authorization.replace(\"Bearer \", \"\"));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"{{email}}\",\r\n  \"password\": \"{{password}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/login",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        }
